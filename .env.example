# Copy to .env for local development. NEVER commit the real .env (see .gitignore).
# In GitHub Actions, set these as repository secrets instead.

# SEC EDGAR requires a descriptive User-Agent on every request, formatted as
# "AppName contact@email" (CLAUDE.md §2). Requests without it get blocked.
SEC_USER_AGENT="Nasdaq100Dashboard you@example.com"

# Optional override for where Parquet snapshots are written. Defaults to ./data.
# DATA_DIR="data"

# Massive.com (formerly Polygon) — for backend price ingestion only (not the Streamlit UI).
# Get your key at https://massive.com/dashboard — never commit the real value.
# PRICE_SOURCE=massive
# MASSIVE_API_KEY="your_key_here"
